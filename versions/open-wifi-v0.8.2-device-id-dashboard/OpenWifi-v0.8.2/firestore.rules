rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOpenWifiAdmin() {
      return request.auth != null && request.auth.token.openwifiAdmin == true;
    }

    match /openwifi_sites/{siteId} {
      allow read: if isOpenWifiAdmin();
      allow write: if false;
      match /{document=**} {
        allow read: if isOpenWifiAdmin();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
