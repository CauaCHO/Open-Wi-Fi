# mock = testa sem dinheiro real | mercadopago = cria PIX real
PAYMENTS_MODE=mock
PORT=8080

# Mercado Pago
MP_ACCESS_TOKEN=
# sandbox = teste automático | production = cobrança real
MP_ENV=sandbox
MP_WEBHOOK_SECRET=
MP_STATUS_POLLING=true

# MikroTik: mock = não altera a RB | real = libera/corta o MAC na RB
MIKROTIK_MODE=mock
MIKROTIK_HOST=10.77.0.1
MIKROTIK_USER=openwifi
MIKROTIK_PASSWORD=

# API normal = 8728. Para API-SSL use true + 8729 e configure certificado na RB.
MIKROTIK_USE_TLS=false
MIKROTIK_PORT=8728
# true valida o certificado. Para certificado próprio/self-signed em laboratório,
# pode usar false temporariamente; em produção prefira certificado confiável.
MIKROTIK_TLS_VERIFY=true
MIKROTIK_TIMEOUT_MS=5000

# all ou o nome do HotSpot da RB, por exemplo hotspot1
MIKROTIK_HOTSPOT_SERVER=openwifi-hotspot

# prefer-router: tenta descobrir o MAC pelo IP na tabela HotSpot e cai para ?mac=
# strict-router: só aceita MAC descoberto pela RB (recomendado quando o backend é local)
# trust-portal: aceita ?mac= diretamente (somente desenvolvimento)
MIKROTIK_DEVICE_VALIDATION=prefer-router

# Reconciliador: restaura acessos pagos após reinício e remove bindings vencidos
MIKROTIK_RECONCILE_MS=30000

# Regras do portal (milissegundos)
ATTEMPT_WINDOW_MS=30000
COOLDOWN_MS=600000
MAX_ATTEMPTS=3

# Validade local do PIX (acompanha PT30M do Mercado Pago)
PIX_VALIDITY_MS=1800000

# Painel administrativo /admin
ADMIN_USER=admin
ADMIN_PASSWORD=
# Use uma sequência aleatória longa diferente da senha. Se vazio, usa ADMIN_PASSWORD como fallback.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
ADMIN_TIMEZONE=America/Sao_Paulo
# Ative true somente quando o painel estiver atrás de HTTPS.
ADMIN_COOKIE_SECURE=false

# Identidade lógica do aparelho (v0.8.2)
# Usa assinatura HMAC no cookie ow_device. Se vazio, usa ADMIN_SESSION_SECRET.
# Recomenda-se definir um segredo separado e longo.
DEVICE_ID_SECRET=

# Financeiro do painel: ajuste conforme sua taxa/custos reais.
# Ex.: no teste de R$2 -> R$1,98, a taxa observada foi 1%.
MP_FEE_PERCENT=1
MONTHLY_FIXED_COST=0

# ============================================================
# Firebase remoto (v0.8)
# false = painel Firebase desativado; true = sincroniza com Firestore
FIREBASE_ENABLED=false
# Mesmo ID usado em firebase-dashboard/firebase-config.js
FIREBASE_SITE_ID=openwifi-main
FIREBASE_SITE_NAME=Open Wi-Fi
# Atualização do status. Mínimo aplicado pelo código: 5000 ms.
FIREBASE_SYNC_MS=10000
# Remove documentos antigos por MAC após migrar para Device ID lógico.
FIREBASE_PRUNE_CLIENTS=true
# Opcional se o project_id já estiver no JSON da conta de serviço.
FIREBASE_PROJECT_ID=
# Arquivo local PRIVADO baixado em Firebase Console -> Contas de serviço.
# Nunca coloque esse JSON no Hosting/GitHub.
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json
