# mock = testa sem dinheiro real | mercadopago = cria PIX real
PAYMENTS_MODE=mock
PORT=8080

# Preencha para usar Mercado Pago real.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# true ajuda no teste local, quando ainda não existe URL HTTPS pública para webhook.
# Em produção, depois do webhook configurado, prefira false.
MP_STATUS_POLLING=true

# E-mail padrão NÃO é recomendado em produção. O portal pede o e-mail do pagador.
# MP_PAYER_EMAIL_FALLBACK=

# Enquanto a MikroTik ainda não estiver integrada, a aprovação fica registrada
# no backend e a página mostra que o acesso foi aprovado.
MIKROTIK_MODE=mock
