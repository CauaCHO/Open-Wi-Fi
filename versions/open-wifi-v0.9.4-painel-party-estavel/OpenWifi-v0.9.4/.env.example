PORT=8080

# Mercado Pago
PAYMENTS_MODE=mock
MP_ENV=production
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_STATUS_POLLING=true

# Regras de tentativa / PIX
ATTEMPT_WINDOW_MS=30000
COOLDOWN_MS=600000
MAX_ATTEMPTS=3
PIX_VALIDITY_MS=1800000

# MikroTik
MIKROTIK_MODE=mock
MIKROTIK_HOST=10.77.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=openwifi
MIKROTIK_PASSWORD=
MIKROTIK_USE_TLS=false
MIKROTIK_TLS_VERIFY=true
MIKROTIK_HOTSPOT_SERVER=openwifi-hotspot
MIKROTIK_DEVICE_VALIDATION=prefer-router
MIKROTIK_RECONCILE_MS=30000

# Identidade lógica do aparelho
DEVICE_ID_SECRET=troque-por-uma-chave-aleatoria-grande

# Painel local
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_SESSION_SECRET=troque-por-uma-chave-aleatoria-grande
ADMIN_SESSION_HOURS=12
ADMIN_TIMEZONE=America/Sao_Paulo
ADMIN_COOKIE_SECURE=false
MP_FEE_PERCENT=1
MONTHLY_FIXED_COST=0

# Firebase / painel remoto
FIREBASE_ENABLED=false
FIREBASE_SITE_ID=openwifi-main
FIREBASE_SITE_NAME=Open Wi-Fi
FIREBASE_SYNC_MS=10000
FIREBASE_PRUNE_CLIENTS=true
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Party Mode
# WhatsApp é obrigatório para gerar PIX quando o modo Party estiver ativo.
# O telefone é a chave de recuperação do grupo. O portal NÃO abre WhatsApp, banco ou apps externos.

# Página pública de acompanhamento do grupo (Firebase Hosting).
PARTY_GROUP_VIEW_BASE_URL=https://open-wi-fi-ofc.web.app/group.html

# Número do Open Wi-Fi para suporte/recuperação. É apenas exibido como texto; não vira hyperlink.
SUPPORT_WHATSAPP=
